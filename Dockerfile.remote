FROM node:24-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

RUN apt-get update \
  && apt-get install -y --no-install-recommends git openssh-client ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY bin ./bin
COPY docs ./docs
COPY profiles ./profiles
COPY schemas ./schemas
COPY src ./src

RUN useradd --create-home --uid 10001 context-room \
  && mkdir -p /data \
  && chown -R context-room:context-room /data

ARG CONTEXT_ROOM_BUILD_REVISION
ARG CONTEXT_ROOM_BUILD_VERSION

RUN node -e 'const [revision, version] = process.argv.slice(1); const semver = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/; if (!/^[a-f0-9]{40}$/.test(revision || "") || !semver.test(version || "") || version !== require("./package.json").version) process.exit(1)' "${CONTEXT_ROOM_BUILD_REVISION}" "${CONTEXT_ROOM_BUILD_VERSION}" \
  && printf '%s\n' "${CONTEXT_ROOM_BUILD_REVISION}" > /app/.context-room-build-revision \
  && chmod 0444 /app/.context-room-build-revision

LABEL org.opencontainers.image.source="https://github.com/blancmathis/context-room" \
  org.opencontainers.image.revision="${CONTEXT_ROOM_BUILD_REVISION}" \
  org.opencontainers.image.version="${CONTEXT_ROOM_BUILD_VERSION}"

ENV NODE_ENV=production
ENV CONTEXT_ROOM_REMOTE=1
ENV CONTEXT_ROOM_BUILD_REVISION=${CONTEXT_ROOM_BUILD_REVISION}
ENV CONTEXT_ROOM_DATA_ROOT=/data
ENV CONTEXT_ROOM_HOST=0.0.0.0
ENV CONTEXT_ROOM_PORT=4317
EXPOSE 4317
VOLUME ["/data"]
USER context-room
CMD ["node", "bin/context-room-remote.mjs"]
