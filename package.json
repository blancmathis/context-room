{
  "name": "context-room",
  "version": "0.3.2",
  "description": "Local-first documentation control room for AI-assisted projects.",
  "type": "module",
  "homepage": "https://www.npmjs.com/package/context-room",
  "bin": {
    "context-room": "bin/context-room.mjs"
  },
  "exports": {
    ".": "./src/context_room.mjs",
    "./document-extensions": "./src/document_extensions.mjs",
    "./metadata": "./src/document_metadata_engine.mjs"
  },
  "files": [
    ".codex/skills/context-room-documentation/",
    "bin/",
    "scripts/",
    "src/",
    "docs/",
    "examples/",
    "profiles/",
    "schemas/",
    "README.md",
    "PRODUCT.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/context-room.mjs start",
    "init": "node bin/context-room.mjs init",
    "doctor": "node bin/context-room.mjs doctor",
    "test": "node --check src/context_room.mjs && node --check bin/context-room.mjs && node --check scripts/update-context-rooms.mjs && node --check scripts/run-tests.mjs && node --check scripts/audit-layout-css.mjs && node scripts/audit-layout-css.mjs && node scripts/run-tests.mjs",
    "test:ux-smoke": "playwright test --grep @smoke",
    "test:ux-soak": "playwright test --project=chromium-desktop --grep @soak",
    "test:perf": "playwright test --project=chromium-desktop --grep @perf",
    "test:layout": "node scripts/audit-layout-css.mjs && playwright test --grep @layout",
    "audit:layout": "node scripts/audit-layout-css.mjs --json && CONTEXT_ROOM_LAYOUT_REPORT=1 playwright test --grep @layout",
    "package:privacy": "node scripts/check-package-privacy.mjs",
    "prepack": "npm run package:privacy",
    "update:rooms": "node scripts/update-context-rooms.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "ai-agent",
    "context",
    "documentation",
    "docs",
    "skills",
    "agent-loops",
    "local-first",
    "review-queue",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "d3-force": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "mermaid": "^11.16.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
